   ceph::condition_variable sdata_cond;
   int waiting_threads = 0;
+  // perf/osd-2026-09 record 05 (switch 05): the commit owner thread sleeps on
+  // owner_cond and ContextQueue wakes only it; an enqueue wakes one sleeping
+  // thread instead of all of them.  All four counters are under
+  // sdata_wait_lock.
+  ceph::condition_variable owner_cond;
+  int sleeping_workers = 0;  ///< non-owner threads in wait/wait_until
+  int sleeping_owner = 0;    ///< owner thread in wait/wait_until (0 or 1)
+  // wakeups sent but not yet taken: a signalled thread stays counted as
+  // sleeping until it re-takes sdata_wait_lock, so without these a second
+  // item arriving meanwhile would signal nobody.
+  int wake_pending_workers = 0;
+  int wake_pending_owner = 0;
+  /// wake one thread that can run a new item; sdata_wait_lock held
+  void wake_one_for_item() {
+    if (sleeping_workers > wake_pending_workers) {
+      ++wake_pending_workers;
+      sdata_cond.notify_one();
+    } else if (sleeping_owner > wake_pending_owner) {
+      ++wake_pending_owner;
+      owner_cond.notify_one();
+    }
+  }
+  /// wake every thread; sdata_wait_lock held
+  void wake_all() {
+    wake_pending_workers = sleeping_workers;
+    wake_pending_owner = sleeping_owner;
+    sdata_cond.notify_all();
+    owner_cond.notify_all();
+  }
