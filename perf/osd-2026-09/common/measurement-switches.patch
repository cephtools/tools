diff -ruN a/src/osd/perf_patch.h b/src/osd/perf_patch.h
--- a/src/osd/perf_patch.h	1969-12-31 18:00:00.000000000 -0600
+++ b/src/osd/perf_patch.h	2026-09-24 19:27:55.566379016 -0500
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+// Measurement-only switches for the OSD performance study (perf/osd-2026-09).
+// CEPH_PERF_PATCHES is read once per process, e.g. CEPH_PERF_PATCHES=01,02
+// turns on candidates 01 and 02.  Not for production use.
+#pragma once
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+inline bool perf_patch(int n)
+{
+  static const unsigned mask = [] {
+    unsigned m = 0;
+    const char *s = std::getenv("CEPH_PERF_PATCHES");
+    for (int i = 1; s && i < 32; i++) {
+      char id[4];
+      std::snprintf(id, sizeof(id), "%02d", i);
+      if (std::strstr(s, id))
+	m |= 1u << i;
+    }
+    return m;
+  }();
+  return mask & (1u << n);
+}
