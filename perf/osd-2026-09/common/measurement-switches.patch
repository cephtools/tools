+  /// sdata_wait_lock held
+  void woke_up(bool owner) {
+    int &sleeping = owner ? sleeping_owner : sleeping_workers;
+    int &pending = owner ? wake_pending_owner : wake_pending_workers;
+    --sleeping;
+    if (pending > 0)
