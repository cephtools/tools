+void ECCommon::RMWPipeline::submit_rollforward_dummy(
+    const hobject_t &hoid,
+    const eversion_t &trim_to,
+    const eversion_t &pg_committed_to,
+    const osd_reqid_t &reqid) {
+  // submit a dummy, transaction-empty op to kick the rollforward
+  const auto tid = get_parent()->get_tid();
+  const auto nop = std::make_shared<ECDummyOp>(*this);
+  nop->hoid = hoid;
+  nop->trim_to = trim_to;
+  nop->pg_committed_to = pg_committed_to;
+  nop->tid = tid;
+  nop->reqid = reqid;
+  nop->pending_cache_ops = 1;
+  nop->pipeline = this;
+
+  tid_to_op_map[tid] = nop;
+  waiting_commit.push_back(nop);
+
+  /* The cache is idle (checked by the caller) and this IO never blocks for
+   * reads so we can skip the extent cache and immediately call the completion.
+   */
+  nop->cache_ready(nop->hoid, ECUtil::shard_extent_map_t(&sinfo));
+}
+
+#ifndef WITH_CRIMSON
+void ECCommon::RMWPipeline::delayed_rollforward_fire() {
+  // pg_timer thread, PG lock held (taken by intrusive_timer); keep it short
+  if (get_parent()->get_last_peering_reset_epoch() != rf_armed_reset_epoch ||
+      !get_parent()->pgb_is_primary()) {
+    return;
+  }
+  // wait until the PG has been quiet for the whole delay: re-arm for the
+  // rest while writes keep finishing (is_scheduled() is false in invoke()),
+  // but not longer than 4 x delay in total, so that a steady stream of
+  // writes that leave the PG idle only briefly cannot postpone the
+  // roll-forward of the shards they do not touch forever
+  const auto delay = std::chrono::milliseconds(perf_ec_rf_delay_ms());
+  const auto now = ceph::coarse_mono_clock::now();
+  const auto quiet = now - rf_last_idle;
+  if (quiet < delay && now - rf_first_idle < 4 * delay) {
+    get_parent()->get_pg_timer().schedule_after(rf_callback, delay - quiet);
+    return;
+  }
+  // submit from an op worker: the dummy goes down to queue_transactions,
+  // which may block and must not hold up the OSD-wide pg_timer thread.
+  // The blessed context holds a PG ref and is dropped on an interval change.
+  get_parent()->schedule_recovery_work(
+    get_parent()->bless_unlocked_gencontext(
+      make_gen_lambda_context<ThreadPool::TPHandle&>(
+        [this](ThreadPool::TPHandle &) { delayed_rollforward_submit(); })
+        .release()),
+    1);
+}
+
+void ECCommon::RMWPipeline::delayed_rollforward_submit() {
+  // op worker, PG lock held
+  if (!get_parent()->pgb_is_primary() || pending_roll_forward.empty()) {
+    // nothing to roll forward (a dummy with no shard to send to would only
+    // wait in waiting_commit until the next sub-write reply reaps it)
+    return;
+  }
+  if (extent_cache.idle() &&
+      committed_to > get_parent()->get_log().get_can_rollback_to()) {
+    dout(20) << __func__ << " delayed roll forward to " << committed_to
+             << dendl;
+    submit_rollforward_dummy(rf_hoid, rf_trim_to, committed_to, rf_reqid);
+  }
+  // else a write is in flight: its finish_rmw re-arms the timer
+}
+#endif
